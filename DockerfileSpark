FROM apache/spark

WORKDIR /opt/spark/

COPY Spark/jars/*.jar /opt/spark/jars/
COPY Spark/sparkconfig/spark-defaults.conf /opt/spark/conf/spark-defaults.conf
COPY Spark/sparkconfig/hive-site.xml /opt/spark/conf/hive-site.xml

COPY Spark/sparkconfig/requirements.txt .
USER root
RUN pip install --no-cache-dir -r requirements.txt

EXPOSE 4040 7077